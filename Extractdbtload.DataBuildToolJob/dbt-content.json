          "artifactId": "$(/**/DynamicConnection/WHId)",
          "endPoint": "$(/**/DynamicConnection/SQLConnString)"
        }
      }
    }
  },
  "command": {
    "operation": "build",
    "arguments": {
      "exclude": "",
      "threads": 4
    }
  }
}