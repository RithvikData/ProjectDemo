{
  "project": {
    "projectType": "OneLake",
    "folderPath": "dbt"
  },
  "profile": {
    "profileType": "DataWarehouse",
    "schema": "dbo",
    "externalReferences": {},
    "connectionSettings": {
      "name": "TempDW",
      "properties": {
